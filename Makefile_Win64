CC = x86_64-w64-mingw32-gcc
CFLAGS = -O2 -fPIC -Wall -D_GNU_SOURCE -DCONFIG_VERSION=\"V16\" -DWIN32_LEAN_AND_MEAN -D_WIN32_WINNT=0x0602
LDFLAGS = -static -shared
LDLIBS = -lws2_32

SRC = quickjs.c libunicode.c libregexp.c libbf.c cutils.c quickjs-libc.c quickjs-debugger.c quickjs-debugger-transport-win.c
OBJ = $(SRC:.c=.o)

all: quickjs64.dll

quickjs64.dll: $(OBJ)
	$(CC) $(LDFLAGS) -o $@ $^ $(LDLIBS)

clean:
	del *.o *.dll

